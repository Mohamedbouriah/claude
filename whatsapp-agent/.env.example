# ---------- Serveur ----------
PORT=3000
# URL publique HTTPS du serveur (ngrok, Cloudflare Tunnel, VPS...) — sert a configurer le webhook Meta
PUBLIC_URL=

# Protege le dashboard et l'API. Laisser vide = acces libre (dev uniquement).
DASHBOARD_TOKEN=

# ---------- Canal WhatsApp ----------
# mock     = simulateur local, aucun message reel envoye (pour tester)
# cloudapi = WhatsApp Cloud API officielle (Meta)
WHATSAPP_CHANNEL=mock

WA_API_VERSION=v21.0
WA_PHONE_NUMBER_ID=
WA_TOKEN=
# Chaine libre : la meme doit etre saisie dans la config du webhook Meta
WA_VERIFY_TOKEN=closerIA
# App secret Meta : active la verification de signature des webhooks
WA_APP_SECRET=

# ---------- Cerveau ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=2000
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------- Comportement de l'agent ----------
# Attente avant de repondre : laisse le prospect finir d'ecrire (rafales de messages)
AGENT_DEBOUNCE_MS=6000
AGENT_DELAI_MIN_MS=1500
AGENT_DELAI_MAX_MS=4000
AGENT_HISTORIQUE=40
AGENT_MAX_RELANCES=4
# Fenetre horaire d'envoi des relances (heure locale du serveur)
AGENT_HEURE_DEBUT=8
AGENT_HEURE_FIN=22

# ---------- Contexte business (injecte dans le prompt) ----------
BUSINESS_NAME=Ton offre
AGENT_PRENOM=Lea
BOOKING_URL=
# Description de l'offre : prix, promesse, preuves, pour qui, pour qui pas.
# Sur une seule ligne, utiliser \n pour les retours a la ligne.
BUSINESS_OFFRE=
